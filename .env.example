# Hi-Tech Eggplant - environment settings
#
# Copy this file to ".env" (same folder as manage.py) and fill in what you need.
# .env is gitignored, so real keys never reach the repository.
# Everything here is optional: unset features are skipped, not broken.
#
#   cp .env.example .env
#
# Real environment variables override this file, and the file is read at startup,
# so restart runserver after changing it.


# --- Sign in with Google ----------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
#   -> Create credentials -> OAuth client ID -> Web application
# Add these under "Authorized JavaScript origins" (exact scheme, host and port):
#   http://localhost:8000
#   http://127.0.0.1:8000
# No client secret and no redirect URI are needed for this flow.
# Leave blank and the "Continue with Google" button is simply not shown.
GOOGLE_OAUTH_CLIENT_ID=

# Refuse sign-ins where Google has not verified the address (recommended: 1).
GOOGLE_REQUIRE_VERIFIED_EMAIL=1

# --- Firebase manual watering / spraying ------------------------------------
# Copy the exact URL from Firebase Console > Realtime Database.
# Uses the existing service account; sensor readings continue using Firestore.
FIREBASE_DATABASE_URL=


# --- E-mail alerts (Gmail) --------------------------------------------------
# GMAIL_APP_PASSWORD must be an App Password, not the account password:
# turn on 2-Step Verification, then https://myaccount.google.com/apppasswords
# Leave blank and e-mails are printed to the server console instead of sent.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DEFAULT_FROM_EMAIL=


# --- SMS alerts -------------------------------------------------------------
# Fill in ONE gateway. Leave both blank and messages are only written to the log.
# Semaphore (Philippine gateway, cheaper for local 09xx numbers):
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Twilio (works worldwide):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Country code applied to local numbers typed as 09171234567.
SMS_DEFAULT_COUNTRY_CODE=+63

# Set to 0 to mute every alert on every channel, server-wide.
NOTIFICATIONS_ENABLED=1


# --- Django -----------------------------------------------------------------
# Set a real secret key and DJANGO_DEBUG=0 before putting this on a real server.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Server-side weather API key
OPENWEATHER_API_KEY=
